{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ws-workbench",
  "mainBinaryName": "ws-workbench",
  "version": "1.0.25",
  "identifier": "com.ws.workbench",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:8790",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ws-workbench",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDQjRFNEIxRUNFRjMzNTMKUldSVE0rL3NzZVMwbk9uRHJ2TENlSVdrMEcvbjJBeTVJTmRPbTk3Q1NmTUF4cERmRWZwMEl6L2oK",
      "endpoints": [
        "https://gitee.com/feng_wenshan/ws-workbench/raw/master/updates/latest.json",
        "https://gitee.com/feng_wenshan/ws-workbench/raw/main/updates/latest.json",
        "https://raw.githubusercontent.com/fengwenshan/ws-workbench/main/updates/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "copyright": "© 2026 ws-workbench",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis/uninstall-hooks.nsh",
        "installerIcon": "./icons/icon.ico",
        "uninstallerIcon": "./icons/icon.ico",
        "headerImage": "./nsis/header.bmp",
        "uninstallerHeaderImage": "./nsis/header.bmp",
        "sidebarImage": "./nsis/sidebar.bmp",
        "languages": ["SimpChinese"],
        "customLanguageFiles": {
          "SimpChinese": "./nsis/SimpChinese.nsh"
        },
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "resources/zh-Hans.lproj": "zh-Hans.lproj",
      "resources/apps": "apps",
      "resources/windows/uninstall-choose-data.ps1": "resources/windows/uninstall-choose-data.ps1"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
